package main

import (
	"context"
	"database/sql"
	"errors"
	"fmt"
	"log"
	"os"

	"{{.Name}}/cmd/app/env"
	appsql "{{.Name}}/cmd/app/sql"
	"{{.Name}}/internal/db"
{{- if .HasJobs }}
	"{{.Name}}/internal/jobs"
{{- end }}

	"github.com/joho/godotenv"
	"github.com/pressly/goose/v3"
)

const migrationsDir = "migrations"

func main() {
	command := "up"
	if len(os.Args) > 1 {
		command = os.Args[1]
	}

	if err := run(command); err != nil {
		log.Fatal(err)
	}
}

func run(command string) error {
	if err := godotenv.Load(".env"); err != nil {
		return fmt.Errorf("load .env: %w", err)
	}

	vars := env.Load()
	ctx := context.Background()

	database, err := db.NewDB(ctx, &db.Config{
		DatabaseConnString: vars.DatabaseConnString,
	})
	if err != nil {
		return fmt.Errorf("create DB: %w", err)
	}
	defer database.Close()

	goose.SetBaseFS(appsql.Migration)
	if err := goose.SetDialect("{{.Database.Driver}}"); err != nil {
		return fmt.Errorf("set dialect: %w", err)
	}

	switch command {
	case "up":
		return up({{ if .HasJobs }}ctx, {{ end }}database{{ if .HasJobs }}, vars.JobsQueueName{{ end }})
	case "down":
		if err := ignoreNoMigrations(goose.Down(database, migrationsDir)); err != nil {
			return fmt.Errorf("roll back migration: %w", err)
		}
		return nil
	case "status":
		if err := ignoreNoMigrations(goose.Status(database, migrationsDir)); err != nil {
			return fmt.Errorf("read migration status: %w", err)
		}
		return nil
	case "reset":
		if err := ignoreNoMigrations(goose.Reset(database, migrationsDir)); err != nil {
			return fmt.Errorf("reset migrations: %w", err)
		}
		return up({{ if .HasJobs }}ctx, {{ end }}database{{ if .HasJobs }}, vars.JobsQueueName{{ end }})
	default:
		return fmt.Errorf("unknown command %q: want up, down, status or reset", command)
	}
}

func up({{ if .HasJobs }}ctx context.Context, {{ end }}database *sql.DB{{ if .HasJobs }}, queueName string{{ end }}) error {
	if err := ignoreNoMigrations(goose.Up(database, migrationsDir)); err != nil {
		return fmt.Errorf("run migrations: %w", err)
	}
{{- if .HasJobs }}

	if err := jobs.Setup(ctx, database, queueName); err != nil {
		return fmt.Errorf("set up jobs: %w", err)
	}
{{- end }}

	return nil
}

func ignoreNoMigrations(err error) error {
	if errors.Is(err, goose.ErrNoMigrationFiles) {
		return nil
	}

	return err
}
